{
  "title": "DEBRIEF",
  "description": "SWIVEL + Kismet captures, merged and enriched. Local browse only — the only thing that leaves the machine is map-tile requests.",
  "extra_css_urls": [
    "/assets/swivel.css"
  ],
  "databases": {
    "swivel": {
      "tables": {
        "sightings": {
          "plugins": {
            "datasette-cluster-map": {
              "latitude_column": "lat",
              "longitude_column": "lon",
              "tile_layer": "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
              "tile_layer_options": {
                "maxNativeZoom": 16,
                "maxZoom": 19,
                "attribution": "Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ"
              }
            }
          }
        }
      }
    }
  }
}
